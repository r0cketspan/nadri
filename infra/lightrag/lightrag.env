# LightRAG v1.5.7 비밀 아닌 설정 (키 이름은 v1.5.7 태그의 env.example 기준).
# 비밀값(LLM/EMBEDDING API 키, LIGHTRAG_API_KEY, POSTGRES_PASSWORD)은 compose environment로 넣는다.
HOST=0.0.0.0
PORT=9621

# 모델 — 임베딩 모델·차원을 바꾸면 전체 재인덱싱이 필요하다
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 저장소 — 전부 PostgreSQL, 그래프는 AGE 없이 일반 테이블
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGTableGraphStorage
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lightrag
POSTGRES_DATABASE=lightrag
POSTGRES_VECTOR_INDEX_TYPE=HNSW

# 한국어 요약, LightRAG 내장 리랭크는 끔(리랭크는 tour-tools CrossEncoder)
SUMMARY_LANGUAGE=Korean
RERANK_BINDING=null
